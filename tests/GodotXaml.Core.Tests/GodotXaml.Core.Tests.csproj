<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>GodotXaml.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Read, never loaded, by GodotSharpEnumTests and GodotSharpMemberNameTests: the C# API Godot generates, to check the
         computed names against. Editor classes' API is in GodotSharpEditor (bindings_generator.cpp), not GodotSharp. -->
    <PackageReference Include="GodotSharp" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="GodotSharpEditor" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GodotSharpPath" Value="$(PkgGodotSharp)\lib\net8.0\GodotSharp.dll" />
    <AssemblyMetadata Include="GodotSharpEditorPath" Value="$(PkgGodotSharpEditor)\lib\net8.0\GodotSharpEditor.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GodotXaml.Core\GodotXaml.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
