<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>GodotXaml.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Read, never loaded, by GodotSharpEnumTests: the C# enum names Godot generates, to check GodotEnumNames against. -->
    <PackageReference Include="GodotSharp" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GodotSharpPath" Value="$(PkgGodotSharp)\lib\net8.0\GodotSharp.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GodotXaml.Core\GodotXaml.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
