<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>GodotXaml.LanguageServer</RootNamespace>
    <AssemblyName>GodotXaml.LanguageServer</AssemblyName>
    <!-- Shipped as per-platform executables inside the editor extensions, not as a NuGet package. -->
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GodotXaml.Core\GodotXaml.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GodotXaml.LanguageServer.Tests" />
  </ItemGroup>
</Project>
