<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>GodotXaml.LanguageServer</RootNamespace>
    <AssemblyName>GodotXaml.LanguageServer</AssemblyName>
    <!-- Shipped as per-platform executables inside the editor extensions, not as a NuGet package. -->
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GodotXaml.Core\GodotXaml.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The class reference ships inside the executable, as the core ships the metadata: a single-file or NativeAOT build
         has no folder beside it to read from (ClassDocs.LoadBundled). The glob picks up a later Godot minor version. -->
    <EmbeddedResource Include="..\..\metadata\docs\godot-*.json" LogicalName="docs/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GodotXaml.LanguageServer.Tests" />
  </ItemGroup>
</Project>
