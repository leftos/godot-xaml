<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>GodotXaml.LanguageServer</RootNamespace>
    <AssemblyName>GodotXaml.LanguageServer</AssemblyName>
    <!-- Shipped as per-platform executables inside the editor extensions, not as a NuGet package. -->
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The server ships as NativeAOT executables. The trim and AOT analyzers run on this project's code in every build,
         warnings as errors; the core and the packages are checked by ILC at publish (tools/publish-server.ps1). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Only a NativeAOT publish (tools/publish-server.ps1) takes these; a build and the in-process tests do not. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
    <!-- StreamJsonRpc brings PolyType without its source generator; the generated shape of ILanguageServerTarget is what
         registers the RPC methods without reflection under NativeAOT (RpcTargetMetadata.FromShape). -->
    <PackageReference Include="PolyType" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GodotXaml.Core\GodotXaml.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The class reference ships inside the executable, as the core ships the metadata: a single-file or NativeAOT build
         has no folder beside it to read from (ClassDocs.LoadBundled). The glob picks up a later Godot minor version. -->
    <EmbeddedResource Include="..\..\metadata\docs\godot-*.json" LogicalName="docs/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GodotXaml.LanguageServer.Tests" />
  </ItemGroup>
</Project>
