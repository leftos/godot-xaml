<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>GodotXaml.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>godot-xaml</ToolCommandName>
    <PackageId>GodotXaml.Cli</PackageId>
    <Authors>Leftos Aslanoglou</Authors>
    <Description>Checks, converts, formats and upgrades Godot scenes and resources written as XAML.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/leftos/godot-xaml</PackageProjectUrl>
    <RepositoryUrl>https://github.com/leftos/godot-xaml</RepositoryUrl>
    <PackageTags>godot xaml scene cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GodotXaml.Core\GodotXaml.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GodotXaml.Cli.Tests" />
  </ItemGroup>
</Project>
