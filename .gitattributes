# LF everywhere; Windows batch files keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# gdformat on Windows rewrites a file with CRLF endings; GDScript is stored and checked out LF.
*.gd text eol=lf

# Godot writes the fixtures exactly (raw CR, no final newline); git must not touch their line endings.
tests/fixtures/** -text
