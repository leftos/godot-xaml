; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-xaml"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[dotnet]

project/assembly_name="GodotXaml.Addon"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_xaml/plugin.cfg")

[shader_globals]

; The globals the ShaderGlobalsOverride of tests/fixtures/scenes/shader_parameters.tscn overrides.
g0={
"type": "float",
"value": 1.0
}
